# MongoDB Atlas connection string (used by Next.js API routes only)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ve-cung-toi?retryWrites=true&w=majority
MONGODB_DB_NAME="ve-cung-toi"
# Base URL of the PartyKit deployment, e.g. https://ve-cung-toi.<username>.partykit.dev
# Leave as-is for local development (partykit dev defaults to 127.0.0.1:1999)
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# Base URL of the Next.js app itself, used by the PartyKit server to call
# POST /api/game-history when a game ends. Without this, games simply never
# get saved to game_history (silently, on purpose — history is best-effort).
# Local dev: http://localhost:3000. Production: your Vercel domain.
NEXT_APP_URL=http://localhost:3000
