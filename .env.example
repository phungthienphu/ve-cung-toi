# MongoDB Atlas connection string (used by Next.js API routes only)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ve-cung-toi?retryWrites=true&w=majority
MONGODB_DB_NAME="ve-cung-toi"
# Host of the realtime server (PartyServer on Cloudflare Workers, see
# wrangler.jsonc), e.g. ve-cung-toi.<your-subdomain>.workers.dev
# Local development: `npm run dev` serves it on port 1999. Use your LAN IP
# (e.g. 192.168.1.10:1999) instead of 127.0.0.1 to play from phones.
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# Base URL of the Next.js app, used by the realtime server to POST finished
# games to /api/game-history (best-effort; unset = games just aren't saved).
# This one is read by the Worker, not by Next.js: local dev passes
# http://localhost:3000 via `npm run dev:party`; in production set it with
#   npx wrangler secret put NEXT_APP_URL   (value: your Vercel domain)
NEXT_APP_URL=http://localhost:3000

# Public site URL used to build absolute Open Graph / Twitter card image
# links (see src/app/layout.tsx). Set this to your real production domain.
NEXT_PUBLIC_SITE_URL=https://ve-cung-toi.vercel.app

# Cloudflare Web Analytics site token. The site's own token is built into
# src/app/layout.tsx; set this only to use another one, or to an empty value
# to turn tracking off. Production builds only.
# NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Password required to delete match history from /leaderboard (defaults to a built-in value if unset)
HISTORY_DELETE_PASSWORD=

# Math Quest lesson notebook (/math-quest): the tutor's login password. It also
# signs the student/tutor session cookies, so changing it logs everyone out.
# Required — without it the notebook and tutor page are disabled.
MATH_QUEST_TUTOR_PASSWORD=

# AI reading for the fortune teller (/api/fortune, see src/lib/fortuneProviders.ts).
# Server-only. Set ONE source; with neither, the page uses its offline reading.
# 1) An OpenAI-compatible Responses API endpoint (e.g. a company AI router):
AI_ROUTER_API_KEY=
AI_ROUTER_BASE_URL=
AI_ROUTER_MODEL=gpt-6.1-sol
# 2) Or Claude: an API key from console.anthropic.com.
ANTHROPIC_API_KEY=
# Math Quest "Xưởng đề AI" uses the router above only (not Claude). Optional:
# a different router model for writing exercises (default: AI_ROUTER_MODEL).
AI_EXERCISE_MODEL=

# Google sign-in (optional). Leave empty to keep guest-only mode. Server-side only.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
AUTH_URL=http://localhost:3012

# Same random secret in Next.js and Cloudflare Workers (wrangler secret put).
# Required for new online matches to count toward account statistics.
GAME_HISTORY_SECRET=

# Enable only after account auth migration + verified sender setup.
AUTH_EMAIL_ENABLED=false
RESEND_API_KEY=
AUTH_EMAIL_FROM=
AUTH_PUBLIC_ORIGIN=http://localhost:3012
# Only for a custom trusted reverse proxy that overwrites x-forwarded-for.
AUTH_TRUST_PROXY=false

# Optional server-only admin allowlist, comma separated. Empty disables admin access.
# If omitted, the project owner's configured default is used.
# ADMIN_EMAILS=

# Community WebSocket authentication: same secret in Next and Worker.
# Set via wrangler secret put COMMUNITY_REALTIME_SECRET for production.
# Falls back to GAME_HISTORY_SECRET if already shared. Never use AUTH_SECRET here.
COMMUNITY_REALTIME_SECRET=
# Optional community host; defaults to NEXT_PUBLIC_PARTYKIT_HOST.
# NEXT_PUBLIC_COMMUNITY_HOST=127.0.0.1:1999
