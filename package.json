{
  "name": "ve-cung-toi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:next": "next dev",
    "dev:party": "wrangler dev --port 1999 --ip 0.0.0.0 --var NEXT_APP_URL:http://localhost:3000",
    "dev": "concurrently -n NEXT,PARTY -c blue,magenta \"npm:dev:next\" \"npm:dev:party\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "seed": "tsx scripts/seed.ts",
    "party:deploy": "wrangler deploy",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p party/tsconfig.json",
    "test:tank": "node --import tsx scripts/tank-simulation.test.ts",
    "test:hill": "node --import tsx scripts/hill-phase2.test.ts && node --import tsx scripts/hill-race.test.ts && node --import tsx scripts/hill-sky-road.test.ts && node --import tsx scripts/hill-smoke.test.ts",
    "test:layout": "node --import tsx scripts/css-layout.test.ts",
    "test:account": "node --import tsx scripts/account-client.test.ts",
    "test:account:merge": "node --import tsx scripts/account-merge.integration.ts",
    "test:account:api": "node --import tsx scripts/account-api.integration.ts",
    "dev:account-review": "node --import tsx scripts/account-review.ts",
    "test:account:profile": "node --import tsx scripts/account-profile.integration.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "canvas-confetti": "^1.9.4",
    "katex": "^0.16.22",
    "mongoose": "^8.9.5",
    "nanoid": "^5.0.9",
    "next": "^15.1.4",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.45.1",
    "partyserver": "0.5.10",
    "partysocket": "^1.0.2",
    "planck": "~1.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@eslint/eslintrc": "^3.2.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.4",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "wrangler": "^4.149.0"
  }
}
